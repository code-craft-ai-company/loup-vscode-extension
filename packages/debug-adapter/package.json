{
  "name": "loup-debug-adapter",
  "version": "1.21.1",
  "description": "Debug Adapter Protocol implementation for the Loup programming language",
  "private": true,
  "main": "./out/debugAdapter.js",
  "scripts": {
    "build": "esbuild src/debugAdapter.ts --bundle --outfile=out/debugAdapter.js --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.65.0",
    "@vscode/debugprotocol": "^1.65.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
