{
  "name": "loup-lang",
  "displayName": "Loup Language",
  "description": "Language support for the Loup programming language (v1.20)",
  "version": "1.21.0",
  "publisher": "code-craft-ai-company",
  "author": {
    "name": "Code Craft AI LLC"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/code-craft-ai-company/loup-vscode-extension.git"
  },
  "homepage": "https://github.com/code-craft-ai-company/loup-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/code-craft-ai-company/loup-vscode-extension/issues"
  },
  "license": "MIT",
  "pricing": "Free",
  "icon": "icons/loup.png",
  "preview": true,
  "galleryBanner": {
    "color": "#1b1f2a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "loup",
    "loup-lang",
    "programming-language",
    "trace",
    "time-travel"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "loup",
        "aliases": [
          "Loup",
          "loup"
        ],
        "extensions": [
          ".loup"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file-loup.svg",
          "dark": "./icons/file-loup.svg"
        }
      },
      {
        "id": "loup-script",
        "aliases": [
          "Loup (host-script)"
        ],
        "extensions": [
          ".lpscr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file-lpscr.svg",
          "dark": "./icons/file-lpscr.svg"
        }
      },
      {
        "id": "loup-freestanding",
        "aliases": [
          "Loup (freestanding)"
        ],
        "extensions": [
          ".lpfree"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file-lpfree.svg",
          "dark": "./icons/file-lpfree.svg"
        }
      },
      {
        "id": "loup-web",
        "aliases": [
          "Loup (web)"
        ],
        "extensions": [
          ".lpweb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file-lpweb.svg",
          "dark": "./icons/file-lpweb.svg"
        }
      },
      {
        "id": "loup-native",
        "aliases": [
          "Loup (host-compiled)"
        ],
        "extensions": [
          ".lphc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file-lphc.svg",
          "dark": "./icons/file-lphc.svg"
        }
      },
      {
        "id": "loup-pkg",
        "aliases": [
          "Loup Package",
          "Loup Manifest"
        ],
        "filenames": [
          "package.lppkg",
          "loup.pkg"
        ],
        "extensions": [
          ".lppkg"
        ],
        "configuration": "./loup-pkg-language-configuration.json",
        "icon": {
          "light": "./icons/file-lppkg.svg",
          "dark": "./icons/file-lppkg.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "loup",
        "scopeName": "source.loup",
        "path": "./syntaxes/loup.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.shellscript": "shellscript"
        }
      },
      {
        "language": "loup-script",
        "scopeName": "source.loup",
        "path": "./syntaxes/loup.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.shellscript": "shellscript"
        }
      },
      {
        "language": "loup-freestanding",
        "scopeName": "source.loup",
        "path": "./syntaxes/loup.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.shellscript": "shellscript"
        }
      },
      {
        "language": "loup-web",
        "scopeName": "source.loup",
        "path": "./syntaxes/loup.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.shellscript": "shellscript"
        }
      },
      {
        "language": "loup-native",
        "scopeName": "source.loup",
        "path": "./syntaxes/loup.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.shellscript": "shellscript"
        }
      },
      {
        "language": "loup-pkg",
        "scopeName": "source.loup-pkg",
        "path": "./syntaxes/loup-pkg.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "loup",
        "path": "./snippets/loup.code-snippets"
      },
      {
        "language": "loup-script",
        "path": "./snippets/loup.code-snippets"
      },
      {
        "language": "loup-freestanding",
        "path": "./snippets/loup.code-snippets"
      },
      {
        "language": "loup-web",
        "path": "./snippets/loup.code-snippets"
      },
      {
        "language": "loup-native",
        "path": "./snippets/loup.code-snippets"
      }
    ],
    "debuggers": [
      {
        "type": "loup",
        "label": "Loup",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "languages": [
          "loup",
          "loup-script",
          "loup-freestanding",
          "loup-web",
          "loup-native"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The Loup source file to run (.loup, .lpscr, .lpweb, .lphc).",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the Loup program.",
                "default": []
              },
              "runArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Options passed to `loup run` before the program, such as `--allow-fs` or `--allow-all`.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory. Defaults to the folder of the program."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables passed to the program.",
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "loup",
            "request": "launch",
            "name": "Run Loup File",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Loup: Run File",
            "description": "Run a Loup file and show its output in the Debug Console",
            "body": {
              "type": "loup",
              "request": "launch",
              "name": "Run ${1:Loup File}",
              "program": "^\"\\${file}\"",
              "runArgs": []
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loup",
          "title": "Loup",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "loup": [
        {
          "id": "loupDependencies",
          "name": "Package Dependencies",
          "when": "workspaceHas:**/*.lppkg || workspaceHas:**/loup.pkg"
        }
      ]
    },
    "commands": [
      {
        "command": "loup.trace.open",
        "title": "Open Trace",
        "category": "Loup",
        "icon": "$(history)"
      },
      {
        "command": "loup.trace.stepBack",
        "title": "Trace: Step Back",
        "category": "Loup",
        "icon": "$(arrow-left)"
      },
      {
        "command": "loup.trace.stepForward",
        "title": "Trace: Step Forward",
        "category": "Loup",
        "icon": "$(arrow-right)"
      },
      {
        "command": "loup.trace.previousException",
        "title": "Trace: Previous Exception",
        "category": "Loup"
      },
      {
        "command": "loup.trace.nextException",
        "title": "Trace: Next Exception",
        "category": "Loup"
      },
      {
        "command": "loup.trace.previousCapture",
        "title": "Trace: Previous Capture",
        "category": "Loup"
      },
      {
        "command": "loup.trace.nextCapture",
        "title": "Trace: Next Capture",
        "category": "Loup"
      },
      {
        "command": "loup.trace.gotoPoint",
        "title": "Trace: Go to Point\u2026",
        "category": "Loup"
      },
      {
        "command": "loup.trace.query",
        "title": "Trace: Query\u2026",
        "category": "Loup",
        "icon": "$(search)"
      },
      {
        "command": "loup.trace.reload",
        "title": "Trace: Reload",
        "category": "Loup"
      },
      {
        "command": "loup.refreshDependencies",
        "title": "Refresh Package Dependencies",
        "category": "Loup",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "loup.refreshDependencies",
          "when": "view == loupDependencies",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "loup.trace.open",
          "when": "resourceExtname == .ltrace",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "loup.trace.stepBack",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.stepForward",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.previousException",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.nextException",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.previousCapture",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.nextCapture",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.gotoPoint",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.query",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.reload",
          "when": "activeCustomEditorId == loup.traceViewer"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "loup",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "test",
              "fmt",
              "check"
            ],
            "description": "The loup command to run."
          },
          "file": {
            "type": "string",
            "description": "The file or directory the command is given (required for run and fmt)."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Further arguments for the command."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "loup",
        "owner": "loup",
        "label": "Loup Compiler",
        "source": "loup",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|info|note)(?:\\[([A-Za-z]\\w*)\\])?:\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "loup.traceViewer",
        "displayName": "Loup Trace Viewer",
        "selector": [
          {
            "filenamePattern": "*.ltrace"
          },
          {
            "filenamePattern": "*.ltrace.view.json"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Loup",
      "properties": {
        "loup.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `loup` executable, used by the trace viewer, tasks and Run. Empty means `$LOUP_PATH`, or else `loup` on `PATH`."
        },
        "loup.toolchainRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "A Loup source checkout. When set, the trace viewer runs the trace tool from it (`source/runtime/tools/loup_debug/main.loup`). Needed until the toolchain ships the `loup debug` command."
        },
        "loup.trace.toolCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The full command of the trace tool, when neither of the above fits. The viewer appends `view <file>` or `query <file> <query> --limit <n>` and reads JSON from its standard output."
        },
        "loup.trace.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "markdownDescription": "How long the trace tool may run before it is stopped, in milliseconds."
        },
        "loup.trace.queryLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "markdownDescription": "The most hits a trace query returns."
        }
      }
    },
    "keybindings": [
      {
        "command": "loup.trace.stepBack",
        "key": "alt+left",
        "when": "activeCustomEditorId == loup.traceViewer"
      },
      {
        "command": "loup.trace.stepForward",
        "key": "alt+right",
        "when": "activeCustomEditorId == loup.traceViewer"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
