{
  "name": "loup-lang",
  "displayName": "Loup Language",
  "description": "Language support for the Loup programming language (v1.20)",
  "version": "1.20.0",
  "publisher": "loup-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "loup",
    "loup-lang",
    "programming-language",
    "debug",
    "time-travel"
  ],
  "activationEvents": [
    "onDebugResolve:loup"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "loup",
        "aliases": [
          "Loup",
          "loup"
        ],
        "extensions": [
          ".loup",
          ".lpscr",
          ".lpfree",
          ".lpweb",
          ".lphc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/loup-light.svg",
          "dark": "./icons/loup-dark.svg"
        }
      },
      {
        "id": "loup-pkg",
        "aliases": [
          "Loup Package",
          "Loup Manifest"
        ],
        "filenames": [
          "package.lppkg",
          "loup.pkg"
        ],
        "extensions": [
          ".lppkg"
        ],
        "configuration": "./loup-pkg-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loup",
        "scopeName": "source.loup",
        "path": "./syntaxes/loup.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.shellscript": "shellscript"
        }
      },
      {
        "language": "loup-pkg",
        "scopeName": "source.loup-pkg",
        "path": "./syntaxes/loup-pkg.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "loup",
        "path": "./snippets/loup.code-snippets"
      }
    ],
    "breakpoints": [
      {
        "language": "loup"
      }
    ],
    "debuggers": [
      {
        "type": "loup",
        "label": "Loup Debug",
        "program": "../debug-adapter/out/debugAdapter.js",
        "runtime": "node",
        "languages": [
          "loup"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the Loup source file to run (.loup, .lpscr, .lpfree, .lpweb, .lphc).",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Command-line arguments passed to the Loup program.",
                "default": []
              },
              "target": {
                "type": "string",
                "enum": [
                  "cli",
                  "browser",
                  "wasm",
                  "node",
                  "bun",
                  "deno",
                  "service",
                  "desktop",
                  "native",
                  "freestanding"
                ],
                "description": "Delivery target profile.",
                "default": "cli"
              },
              "enableTimeTravel": {
                "type": "boolean",
                "description": "Start time-travel capture server on launch (debug.recording).",
                "default": false
              },
              "traceLevel": {
                "type": "string",
                "enum": [
                  "off",
                  "minimal",
                  "full"
                ],
                "description": "Diagnostic instrumentation level for AOT compiled code (--trace-level).",
                "default": "off"
              },
              "portalBreakpoints": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Portal names to activate at launch.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch at the first line.",
                "default": false
              },
              "env": {
                "type": "object",
                "description": "Environment variables passed to the program.",
                "default": {}
              }
            }
          },
          "attach": {
            "properties": {
              "host": {
                "type": "string",
                "description": "Hostname of the running Loup debug server.",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "Port of the running Loup debug server.",
                "default": 9229
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "loup",
            "request": "launch",
            "name": "Run Loup Script",
            "program": "${file}",
            "target": "cli"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Loup: Launch Script",
            "description": "Run a Loup file with debugging",
            "body": {
              "type": "loup",
              "request": "launch",
              "name": "Run ${1:Loup Script}",
              "program": "^\"\\${file}\"",
              "target": "${2|cli,browser,wasm,node,bun,deno,service,desktop,native,freestanding|}"
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loup-debug",
          "title": "Loup",
          "icon": "$(debug-alt)"
        }
      ]
    },
    "views": {
      "loup-debug": [
        {
          "id": "loupPortalBreakpoints",
          "name": "Portal Breakpoints"
        },
        {
          "id": "loupDependencies",
          "name": "Package Dependencies",
          "when": "workspaceHas:**/*.lppkg || workspaceHas:**/loup.pkg"
        }
      ]
    },
    "commands": [
      {
        "command": "loup.portal.toggle",
        "title": "Toggle Portal Breakpoint",
        "category": "Loup"
      },
      {
        "command": "loup.portal.add",
        "title": "Add Portal Breakpoint",
        "category": "Loup",
        "icon": "$(add)"
      },
      {
        "command": "loup.portal.remove",
        "title": "Remove Portal Breakpoint",
        "category": "Loup",
        "icon": "$(trash)"
      },
      {
        "command": "loup.portal.clearAll",
        "title": "Clear All Portal Breakpoints",
        "category": "Loup",
        "icon": "$(clear-all)"
      },
      {
        "command": "loup.trace.open",
        "title": "Open Trace",
        "category": "Loup",
        "icon": "$(history)"
      },
      {
        "command": "loup.trace.stepBack",
        "title": "Trace: Step Back",
        "category": "Loup",
        "icon": "$(arrow-left)"
      },
      {
        "command": "loup.trace.stepForward",
        "title": "Trace: Step Forward",
        "category": "Loup",
        "icon": "$(arrow-right)"
      },
      {
        "command": "loup.trace.previousException",
        "title": "Trace: Previous Exception",
        "category": "Loup"
      },
      {
        "command": "loup.trace.nextException",
        "title": "Trace: Next Exception",
        "category": "Loup"
      },
      {
        "command": "loup.trace.previousCapture",
        "title": "Trace: Previous Capture",
        "category": "Loup"
      },
      {
        "command": "loup.trace.nextCapture",
        "title": "Trace: Next Capture",
        "category": "Loup"
      },
      {
        "command": "loup.trace.gotoPoint",
        "title": "Trace: Go to Point\u2026",
        "category": "Loup"
      },
      {
        "command": "loup.trace.query",
        "title": "Trace: Query\u2026",
        "category": "Loup",
        "icon": "$(search)"
      },
      {
        "command": "loup.trace.reload",
        "title": "Trace: Reload",
        "category": "Loup"
      },
      {
        "command": "loup.showTaskGroups",
        "title": "Show Task Group Visualizer",
        "category": "Loup",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "loup.refreshDependencies",
        "title": "Refresh Package Dependencies",
        "category": "Loup",
        "icon": "$(refresh)"
      },
      {
        "command": "loup.openRepl",
        "title": "Open Loup REPL",
        "category": "Loup",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "loup.portal.add",
          "when": "view == loupPortalBreakpoints",
          "group": "navigation"
        },
        {
          "command": "loup.portal.clearAll",
          "when": "view == loupPortalBreakpoints",
          "group": "navigation"
        },
        {
          "command": "loup.refreshDependencies",
          "when": "view == loupDependencies",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "loup.portal.remove",
          "when": "view == loupPortalBreakpoints",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "loup.trace.open",
          "when": "resourceExtname == .ltrace",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "loup.trace.stepBack",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.stepForward",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.previousException",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.nextException",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.previousCapture",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.nextCapture",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.gotoPoint",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.query",
          "when": "activeCustomEditorId == loup.traceViewer"
        },
        {
          "command": "loup.trace.reload",
          "when": "activeCustomEditorId == loup.traceViewer"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "loup",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Loup command to run (run, build, test, fmt, check)."
          },
          "target": {
            "type": "string",
            "description": "Target profile (cli, browser, wasm, node, bun, deno, service, desktop, native, freestanding)."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "loup",
        "owner": "loup",
        "label": "Loup Compiler",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "loup.repl",
          "title": "Loup REPL",
          "icon": "$(terminal)"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "loup.traceViewer",
        "displayName": "Loup Trace Viewer",
        "selector": [
          {
            "filenamePattern": "*.ltrace"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "loup.traceViewer",
        "displayName": "Loup Trace Viewer (exported view)",
        "selector": [
          {
            "filenamePattern": "*.ltrace.view.json"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Loup",
      "properties": {
        "loup.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `loup` executable. Empty means `loup` on `PATH` (or `$LOUP_PATH`)."
        },
        "loup.toolchainRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "A Loup source checkout. When set, the trace viewer runs the trace tool from it (`source/runtime/tools/loup_debug/main.loup`). Needed until the toolchain ships the `loup debug` command."
        },
        "loup.trace.toolCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The full command of the trace tool, when neither of the above fits. The viewer appends `view <file>` or `query <file> <query> --limit <n>` and reads JSON from its standard output."
        },
        "loup.trace.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "markdownDescription": "How long the trace tool may run before it is stopped, in milliseconds."
        },
        "loup.trace.queryLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "markdownDescription": "The most hits a trace query returns."
        }
      }
    },
    "keybindings": [
      {
        "command": "loup.trace.stepBack",
        "key": "alt+left",
        "when": "activeCustomEditorId == loup.traceViewer"
      },
      {
        "command": "loup.trace.stepForward",
        "key": "alt+right",
        "when": "activeCustomEditorId == loup.traceViewer"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
