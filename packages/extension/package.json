{
  "name": "loup-lang",
  "displayName": "Loup Language",
  "description": "Full language support for the Loup programming language (v1.18) \u2014 syntax highlighting, language intelligence, and debugging with time-travel capabilities.",
  "version": "1.18.0",
  "publisher": "loup-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "loup",
    "programming language",
    "template",
    "async",
    "debugging"
  ],
  "activationEvents": [
    "onDebugResolve:loup"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "loup",
        "aliases": [
          "Loup",
          "loup"
        ],
        "extensions": [
          ".loup"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/loup-light.png",
          "dark": "./icons/loup-dark.png"
        }
      },
      {
        "id": "loup-pkg",
        "aliases": [
          "Loup Package"
        ],
        "filenames": [
          "loup.pkg"
        ],
        "extensions": [
          ".lppkg"
        ],
        "configuration": "./loup-pkg-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loup",
        "scopeName": "source.loup",
        "path": "./syntaxes/loup.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.ui": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.shell": "shellscript"
        }
      },
      {
        "language": "loup-pkg",
        "scopeName": "source.loup-pkg",
        "path": "./syntaxes/loup-pkg.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "loup",
        "path": "./snippets/loup.code-snippets"
      }
    ],
    "breakpoints": [
      {
        "language": "loup"
      }
    ],
    "debuggers": [
      {
        "type": "loup",
        "label": "Loup Debug",
        "languages": [
          "loup"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the Loup file to run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the Loup program.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "target": {
                "type": "string",
                "description": "Target platform. Corresponds to the file's @mode(...) directive (v1.18 \u00a72.5.2). web.scripted: browser/node/bun/deno. web.compiled: wasm/browser. host.scripted / host.dual / host.native: native/cli/service/desktop. freestanding: bare-metal.",
                "enum": [
                  "cli",
                  "browser",
                  "service",
                  "desktop",
                  "native",
                  "wasm",
                  "node",
                  "bun",
                  "deno",
                  "freestanding"
                ],
                "default": "cli"
              },
              "enableTimeTravel": {
                "type": "boolean",
                "description": "Start a time-travel capture server on launch.",
                "default": false
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the Loup process.",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              }
            }
          },
          "attach": {
            "properties": {
              "port": {
                "type": "number",
                "description": "Debug port of the running Loup process.",
                "default": 9229
              },
              "host": {
                "type": "string",
                "description": "Hostname of the running Loup process.",
                "default": "localhost"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "loup",
            "request": "launch",
            "name": "Run Loup Script",
            "program": "${file}",
            "target": "cli"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Loup: Launch Script",
            "description": "Launch a Loup script with debugging.",
            "body": {
              "type": "loup",
              "request": "launch",
              "name": "Run ${1:script}",
              "program": "^\"\\${file}\"",
              "target": "${2|cli,browser,service,desktop,native,wasm,freestanding|}"
            }
          },
          {
            "label": "Loup: Attach to Process",
            "description": "Attach the debugger to a running Loup process.",
            "body": {
              "type": "loup",
              "request": "attach",
              "name": "Attach to Loup",
              "port": 9229,
              "host": "localhost"
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loup-debug",
          "title": "Loup",
          "icon": "$(debug-alt)"
        }
      ]
    },
    "views": {
      "debug": [
        {
          "id": "loupPortalBreakpoints",
          "name": "Portal Breakpoints",
          "when": "debugType == 'loup' || editorLangId == 'loup'"
        }
      ],
      "explorer": [
        {
          "id": "loupDependencies",
          "name": "Loup Dependencies",
          "when": "workspaceHas:**/*.lppkg || workspaceHas:**/loup.pkg",
          "icon": "$(package)"
        }
      ]
    },
    "commands": [
      {
        "command": "loup.togglePortalBreakpoint",
        "title": "Toggle Portal Breakpoint",
        "category": "Loup"
      },
      {
        "command": "loup.addPortalBreakpoint",
        "title": "Add Portal Breakpoint",
        "category": "Loup",
        "icon": "$(add)"
      },
      {
        "command": "loup.removePortalBreakpoint",
        "title": "Remove Portal Breakpoint",
        "category": "Loup",
        "icon": "$(trash)"
      },
      {
        "command": "loup.clearPortalBreakpoints",
        "title": "Clear All Portal Breakpoints",
        "category": "Loup",
        "icon": "$(clear-all)"
      },
      {
        "command": "loup.startCapture",
        "title": "Start Time-Travel Capture",
        "category": "Loup",
        "icon": "$(record)"
      },
      {
        "command": "loup.stopCapture",
        "title": "Stop Time-Travel Capture",
        "category": "Loup",
        "icon": "$(debug-stop)"
      },
      {
        "command": "loup.showTimeline",
        "title": "Show Timeline",
        "category": "Loup",
        "icon": "$(timeline-open)"
      },
      {
        "command": "loup.openTraceFile",
        "title": "Open Trace File",
        "category": "Loup"
      },
      {
        "command": "loup.saveTrace",
        "title": "Save Trace File",
        "category": "Loup"
      },
      {
        "command": "loup.showTaskGroups",
        "title": "Show Task Group Visualizer",
        "category": "Loup",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "loup.refreshDependencies",
        "title": "Refresh Dependencies",
        "category": "Loup",
        "icon": "$(refresh)"
      },
      {
        "command": "loup.openRepl",
        "title": "Open Loup REPL",
        "category": "Loup",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "loup.addPortalBreakpoint",
          "when": "view == loupPortalBreakpoints",
          "group": "navigation"
        },
        {
          "command": "loup.clearPortalBreakpoints",
          "when": "view == loupPortalBreakpoints",
          "group": "navigation"
        },
        {
          "command": "loup.refreshDependencies",
          "when": "view == loupDependencies",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "loup.removePortalBreakpoint",
          "when": "view == loupPortalBreakpoints",
          "group": "inline"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "loup",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The loup command to run (run, build, test, script:name)"
          },
          "cwd": {
            "type": "string",
            "description": "Working directory"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "loup",
        "owner": "loup",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning|info):\\s+(.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s+-->\\s+(.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "loup.repl",
          "title": "Loup REPL",
          "icon": "terminal"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:vscode-languageclient --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "lint": "eslint src/**/*.ts",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
