{
  "Function Declaration": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}): ${3:void} {",
      "  $0",
      "}"
    ],
    "description": "Loom function declaration"
  },
  "Async Function Declaration": {
    "prefix": "afunc",
    "body": [
      "async func ${1:name}(${2:params}): Task[${3:void}] {",
      "  $0",
      "}"
    ],
    "description": "Loom async function declaration"
  },
  "Generator Function": {
    "prefix": "gfunc",
    "body": [
      "gen func ${1:name}(${2:params}): ${3:int} {",
      "  yield $0;",
      "}"
    ],
    "description": "Generator function declaration"
  },
  "Async Generator Function": {
    "prefix": "agfunc",
    "body": [
      "async gen func ${1:name}(${2:params}): ${3:int} {",
      "  yield $0;",
      "}"
    ],
    "description": "Async generator function declaration"
  },
  "Public Function": {
    "prefix": "pfunc",
    "body": [
      "pub func ${1:name}(${2:params}): ${3:void} {",
      "  $0",
      "}"
    ],
    "description": "Public function declaration"
  },
  "Public Async Function": {
    "prefix": "pafunc",
    "body": [
      "pub async func ${1:name}(${2:params}): Task[${3:void}] {",
      "  $0",
      "}"
    ],
    "description": "Public async function declaration"
  },
  "Operator Method": {
    "prefix": "opfunc",
    "body": [
      "operator func ${1:op}(${2:other}: ${3:Self}): ${4:Self} {",
      "  $0",
      "}"
    ],
    "description": "Operator overload method"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "  ${2:Variant1},",
      "  ${3:Variant2},",
      "}"
    ],
    "description": "Loom enum (sum type) declaration"
  },
  "Enum with Payload": {
    "prefix": "enump",
    "body": [
      "enum ${1:Name} {",
      "  ${2:Variant1}(${3:payload}: ${4:type}),",
      "  ${5:Variant2},",
      "}"
    ],
    "description": "Loom enum with payload variant"
  },
  "Class Declaration": {
    "prefix": "class",
    "body": [
      "class ${1:Name} : ${2:Any} {",
      "  $0",
      "}"
    ],
    "description": "Loom class declaration"
  },
  "Dynamic Class": {
    "prefix": "dclass",
    "body": [
      "dynamic class ${1:Name} {",
      "  $0",
      "}"
    ],
    "description": "Loom dynamic class (opt-in dynamic fields)"
  },
  "Abstract Class": {
    "prefix": "aclass",
    "body": [
      "abstract class ${1:Name} {",
      "  pub abstract func ${2:method}(${3:params}): ${4:void};",
      "  $0",
      "}"
    ],
    "description": "Abstract class declaration"
  },
  "Struct Declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "  ${2:field}: ${3:type};",
      "  $0",
      "}"
    ],
    "description": "Loom struct declaration (value type)"
  },
  "Struct with Implements": {
    "prefix": "structi",
    "body": [
      "struct ${1:Name} implements ${2:Interface} {",
      "  ${3:field}: ${4:type};",
      "",
      "  func ${5:method}(${6:params}): ${7:void} {",
      "    $0",
      "  }",
      "}"
    ],
    "description": "Loom struct implementing an interface"
  },
  "Interface Declaration": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "  func ${2:method}(${3:params}): ${4:void};",
      "}"
    ],
    "description": "Loom interface declaration"
  },
  "Type Alias": {
    "prefix": "type",
    "body": "type ${1:Name} = ${2:ExistingType};",
    "description": "Type alias declaration"
  },
  "Macro Declaration": {
    "prefix": "macro",
    "body": [
      "macro ${1:name}(${2:params}) {",
      "  $0",
      "}"
    ],
    "description": "Compile-time macro declaration"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "  ${2:Pattern1} => ${3:result1},",
      "  ${4:Pattern2} => ${5:result2},",
      "  _ => ${6:default},",
      "}"
    ],
    "description": "Pattern matching expression"
  },
  "Match Option": {
    "prefix": "matcho",
    "body": [
      "match ${1:expr} {",
      "  Some(${2:value}) => ${3:result},",
      "  None => ${4:default},",
      "}"
    ],
    "description": "Match over Option[T]"
  },
  "Match Result": {
    "prefix": "matchr",
    "body": [
      "match ${1:expr} {",
      "  Ok(${2:value}) => ${3:result},",
      "  Err(${4:err}) => ${5:handleError},",
      "}"
    ],
    "description": "Match over Result[T, E]"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "  $0",
      "}"
    ],
    "description": "If statement"
  },
  "If-Else Statement": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "  $2",
      "} else {",
      "  $0",
      "}"
    ],
    "description": "If-else statement"
  },
  "For-In Loop": {
    "prefix": "forin",
    "body": [
      "for (${1:item} in ${2:collection}) {",
      "  $0",
      "}"
    ],
    "description": "For-in loop (iterates Iterable[T])"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (let ${1:i} = ${2:0}; ${1:i} < ${3:n}; ${1:i} = ${1:i} + 1) {",
      "  $0",
      "}"
    ],
    "description": "C-style for loop"
  },
  "For Await Loop": {
    "prefix": "forawait",
    "body": [
      "for await (${1:item} in ${2:asyncIterable}) {",
      "  $0",
      "}"
    ],
    "description": "Async for-await loop (iterates AsyncIterable[T])"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "  $0",
      "}"
    ],
    "description": "While loop"
  },
  "Await Group": {
    "prefix": "awaitgroup",
    "body": [
      "await group {",
      "  ${1:result1} = spawn ${2:task1()};",
      "  ${3:result2} = spawn ${4:task2()};",
      "}"
    ],
    "description": "Structured concurrency: await group with spawn"
  },
  "Try-Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "  $1",
      "} catch (${2:Error} as ${3:err}) {",
      "  $0",
      "}"
    ],
    "description": "Try-catch block"
  },
  "Try-Catch-Finally": {
    "prefix": "tryf",
    "body": [
      "try {",
      "  $1",
      "} catch (${2:Error} as ${3:err}) {",
      "  $4",
      "} finally {",
      "  $0",
      "}"
    ],
    "description": "Try-catch-finally block"
  },
  "Defer Call": {
    "prefix": "defer",
    "body": "defer ${1:cleanup()};",
    "description": "Defer a cleanup call (LIFO on block exit)"
  },
  "Defer Block": {
    "prefix": "deferb",
    "body": [
      "defer {",
      "  $0",
      "}"
    ],
    "description": "Defer block (LIFO on block exit)"
  },
  "With Statement": {
    "prefix": "with",
    "body": [
      "with (${1:handle} = ${2:resource}) {",
      "  $0",
      "}"
    ],
    "description": "Scoped resource management with auto-close"
  },
  "Portal Statement": {
    "prefix": "portal",
    "body": [
      "portal ${1:name} {",
      "  $0",
      "}"
    ],
    "description": "Time-travel activation point"
  },
  "Yield": {
    "prefix": "yield",
    "body": "yield ${1:value};",
    "description": "Yield value from generator"
  },
  "Yield From": {
    "prefix": "yieldf",
    "body": "yield * ${1:iterable};",
    "description": "Yield all values from another iterable"
  },
  "Delete Statement": {
    "prefix": "del",
    "body": "del ${1:target};",
    "description": "Delete a dynamic field or dict entry"
  },
  "Import From": {
    "prefix": "from",
    "body": "from ${1:package.module} import (${2:Name});",
    "description": "Import from a module"
  },
  "Import Block": {
    "prefix": "fromb",
    "body": [
      "from ${1:package} {",
      "  ${2:module} import (${3:Name});",
      "}"
    ],
    "description": "Block import from a package"
  },
  "Re-export": {
    "prefix": "pubfrom",
    "body": "pub from ${1:.module} import (${2:Name});",
    "description": "Re-export symbols from a module"
  },
  "Template Fence HTML": {
    "prefix": "tmplhtml",
    "body": [
      "```(html):(${1:none})",
      "  $0",
      "```"
    ],
    "description": "HTML template fence"
  },
  "Template Fence with Components": {
    "prefix": "tmplcomp",
    "body": [
      "```(html):(components=${1:registry})",
      "  $0",
      "```"
    ],
    "description": "HTML template fence with component registry"
  },
  "Template Fence UI": {
    "prefix": "tmplui",
    "body": [
      "```(ui):(${1:none})",
      "  $0",
      "```"
    ],
    "description": "Cross-platform UI template fence"
  },
  "Template Fence Generic": {
    "prefix": "tmpl",
    "body": [
      "```(${1:language}):(${2:none})",
      "  $0",
      "```"
    ],
    "description": "Template fence for any language"
  },
  "Extern JS Function": {
    "prefix": "externjs",
    "body": "extern js func ${1:name}(${2:params}): ${3:Any};",
    "description": "JavaScript FFI function binding"
  },
  "Extern JS Value": {
    "prefix": "externjsval",
    "body": "extern js val ${1:name}: ${2:Any};",
    "description": "JavaScript FFI value binding"
  },
  "Extern Native Function": {
    "prefix": "externnative",
    "body": "extern native \"${1:libname}\" func ${2:name}(${3:params}): ${4:int};",
    "description": "Native shared library FFI function binding"
  },
  "Extern Native Value": {
    "prefix": "externnativeval",
    "body": "extern native \"${1:libname}\" val ${2:name}: ${3:NativeHandle};",
    "description": "Native shared library FFI value binding"
  },
  "JS Export": {
    "prefix": "jsexport",
    "body": [
      "@jsexport",
      "func ${1:name}(${2:params}): ${3:void} {",
      "  $0",
      "}"
    ],
    "description": "Export a Loom function to JavaScript"
  },
  "JS Export Async": {
    "prefix": "jsexporta",
    "body": [
      "@jsexport",
      "async func ${1:name}(${2:params}): Task[${3:void}] {",
      "  $0",
      "}"
    ],
    "description": "Export an async Loom function to JavaScript"
  },
  "Compiled Directive": {
    "prefix": "compiled",
    "body": "@compiled",
    "description": "File-level @compiled directive for AOT compilation"
  },
  "Signal": {
    "prefix": "signal",
    "body": "let ${1:name} = signal(${2:initialValue});",
    "description": "Create a reactive signal (system.ui)"
  },
  "Derived Signal": {
    "prefix": "derived",
    "body": "let ${1:name} = derived(func() => ${2:expr});",
    "description": "Create a derived (computed) signal"
  },
  "Effect": {
    "prefix": "effect",
    "body": [
      "effect(func() {",
      "  $0",
      "});"
    ],
    "description": "Create a reactive effect (system.ui)"
  },
  "Component": {
    "prefix": "component",
    "body": [
      "func ${1:Name}(${2:props}): View {",
      "  $3",
      "  return ```(html):(components=${4:registry})",
      "    $0",
      "  ```;",
      "}"
    ],
    "description": "Reactive UI component returning View"
  },
  "Capture List Lambda": {
    "prefix": "funcw",
    "body": [
      "func [${1:weak} ${2:self}](${3:params}) {",
      "  $0",
      "}"
    ],
    "description": "Lambda with capture list (weak/unowned)"
  },
  "Loom Package Manifest": {
    "prefix": "loompkg",
    "body": [
      "package   ${1:my-app}",
      "version   ${2:0.1.0}",
      "loom      \">=0.7\"",
      "",
      "[deps]",
      "${3:# dependency = \"^1.0\"}",
      "",
      "[dev-deps]",
      "${4:# test-runner = \"^3.1\"}",
      "",
      "[target.${5:cli}]",
      "${6:include system.fs}",
      "${7:include system.proc}"
    ],
    "description": "loom.pkg package manifest scaffold"
  },
  "Safe HTML Interpolation": {
    "prefix": "safehtml",
    "body": "let ${1:html} = SafeHtml.of(${2:content});",
    "description": "Wrap content in SafeHtml for safe template interpolation (v0.7)"
  },
  "Raw Filter": {
    "prefix": "rawfilter",
    "body": "{$ ${1:expr} | raw $}",
    "description": "Unescaped interpolation using | raw filter (v0.7 — use with caution)"
  },
  "URL Validation": {
    "prefix": "urlof",
    "body": "let ${1:url} = Url.of(${2:urlString});",
    "description": "Validate and create a safe Url value (v0.7)"
  },
  "Nested Fence (4-backtick)": {
    "prefix": "tmpl4",
    "body": [
      "````(${1:html}):(${2:none})",
      "  $0",
      "````"
    ],
    "description": "4-backtick template fence for Loom-in-Loom generation (v0.7)"
  },
  "State Serializer": {
    "prefix": "stateserializer",
    "body": [
      "let serializer = StateSerializer.new(stateIntegrity: ${1|true,false|});",
      "let json = serializer.serialize(${2:state});"
    ],
    "description": "SSR state serializer with optional integrity hash (v0.7)"
  },
  "Browser Bootstrap HTML": {
    "prefix": "loomhtml",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"${1:en}\">",
      "<head>",
      "  <meta charset=\"UTF-8\">",
      "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "  <title>${2:Loom App}</title>",
      "  <meta",
      "    http-equiv=\"Content-Security-Policy\"",
      "    content=\"default-src 'self'; script-src 'self' 'wasm-unsafe-eval'\"",
      "  >",
      "  <script type=\"module\" src=\"loom-rt.js\"></script>",
      "</head>",
      "<body>",
      "  <div id=\"root\"></div>",
      "</body>",
      "</html>"
    ],
    "description": "Minimal browser bootstrap HTML template for Loom (v0.7 §27.6)"
  }
}
