{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loom Package Manifest",
  "scopeName": "source.loom-pkg",
  "fileTypes": ["loom.pkg"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#top-level-keys" },
    { "include": "#dependency-entry" },
    { "include": "#target-directive" },
    { "include": "#strings" },
    { "include": "#version-constraint" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.loom-pkg",
      "match": "#.*$"
    },
    "sections": {
      "name": "entity.name.section.loom-pkg",
      "match": "^\\s*(\\[[a-zA-Z0-9_.\\-]+\\])\\s*$",
      "captures": {
        "1": { "name": "entity.name.section.loom-pkg" }
      }
    },
    "top-level-keys": {
      "match": "^\\s*(package|version|loom)\\s+(.+)$",
      "captures": {
        "1": { "name": "keyword.other.definition.loom-pkg" },
        "2": { "name": "string.unquoted.value.loom-pkg" }
      }
    },
    "dependency-entry": {
      "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_.\\-]*)\\s*=\\s*(\"[^\"]*\"|'[^']*')",
      "captures": {
        "1": { "name": "entity.name.tag.dependency.loom-pkg" },
        "2": { "name": "string.quoted.version.loom-pkg" }
      }
    },
    "target-directive": {
      "match": "^\\s*(include|exclude)\\s+([a-zA-Z_][a-zA-Z0-9_.]*)",
      "captures": {
        "1": { "name": "keyword.control.target.loom-pkg" },
        "2": { "name": "entity.name.namespace.loom-pkg" }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.loom-pkg",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.loom-pkg",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "version-constraint": {
      "name": "constant.numeric.version.loom-pkg",
      "match": "\\b[0-9]+\\.[0-9]+(\\.[0-9]+)?\\b"
    },
    "identifiers": {
      "name": "variable.other.loom-pkg",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_.\\-]*\\b"
    }
  }
}
