{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loom",
  "scopeName": "source.loom",
  "fileTypes": ["loom"],
  "patterns": [
    { "include": "#shebang" },
    { "include": "#comments" },
    { "include": "#compiled-directive" },
    { "include": "#annotations" },
    { "include": "#template-fence" },
    { "include": "#multiline-string-double" },
    { "include": "#multiline-string-single" },
    { "include": "#bytes-literal" },
    { "include": "#raw-string" },
    { "include": "#interpolated-strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#constants" },
    { "include": "#extern-declarations" },
    { "include": "#macro-invocation" },
    { "include": "#macro-declaration" },
    { "include": "#async-gen-function-declaration" },
    { "include": "#gen-function-declaration" },
    { "include": "#async-function-declaration" },
    { "include": "#operator-method-declaration" },
    { "include": "#function-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#struct-declaration" },
    { "include": "#abstract-class-declaration" },
    { "include": "#class-declaration" },
    { "include": "#interface-declaration" },
    { "include": "#type-alias-declaration" },
    { "include": "#portal-statement" },
    { "include": "#import-statement" },
    { "include": "#reexport-statement" },
    { "include": "#variable-declaration" },
    { "include": "#type-annotation" },
    { "include": "#dynamic-field-access" },
    { "include": "#method-call" },
    { "include": "#function-call" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {

    "shebang": {
      "name": "comment.line.shebang.loom",
      "match": "\\A(#!).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.shebang.loom" }
      }
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.loom",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.loom",
          "match": "//.*$"
        },
        {
          "name": "comment.block.loom",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },

    "compiled-directive": {
      "comment": "File-level @compiled directive (must be first non-comment line)",
      "name": "meta.directive.compiled.loom",
      "match": "^\\s*(@compiled)\\s*$",
      "captures": {
        "1": { "name": "storage.modifier.compiled.loom" }
      }
    },

    "annotations": {
      "patterns": [
        {
          "comment": "Annotations with optional arguments: @name or @name(...)",
          "name": "meta.annotation.loom",
          "match": "(@)(\\w+)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.loom" },
            "2": { "name": "storage.type.annotation.loom" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.loom",
          "match": "\\b(if|else|for|while|do|match|break|continue|return|throw|try|catch|finally|await|spawn|yield|suspend|group)\\b"
        },
        {
          "name": "keyword.control.import.loom",
          "match": "\\b(from|import|as|prefer|compiled)\\b"
        },
        {
          "name": "keyword.control.defer.loom",
          "match": "\\b(defer)\\b"
        },
        {
          "name": "keyword.control.with.loom",
          "match": "\\b(with)\\b"
        },
        {
          "name": "keyword.control.portal.loom",
          "match": "\\b(portal)\\b"
        },
        {
          "name": "keyword.control.del.loom",
          "match": "\\b(del)\\b"
        },
        {
          "name": "keyword.operator.expression.loom",
          "match": "\\b(in|is|not|and|or|bnot|instanceof|typeof)\\b"
        },
        {
          "name": "keyword.operator.cast.loom",
          "match": "\\b(as\\?)\\b"
        },
        {
          "name": "keyword.operator.box.loom",
          "match": "\\b(box)\\b"
        },
        {
          "name": "keyword.other.loom",
          "match": "\\b(pub|static|new|abstract|implements|global|nonlocal)\\b"
        },
        {
          "name": "keyword.reserved.loom",
          "match": "\\b(final|module|override|package|sealed|self|Self|super|trait|volatile|where)\\b"
        }
      ]
    },

    "storage": {
      "patterns": [
        {
          "name": "storage.type.loom",
          "match": "\\b(let|var|fun|async|gen|class|dynamic|interface|enum|struct|extern|type|macro)\\b"
        },
        {
          "name": "storage.modifier.loom",
          "match": "\\b(pub|static|abstract|operator|weak|unowned|borrow|noescape|lifetime|excl)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "comment": "Built-in primitive types (lowercase)",
          "name": "support.type.primitive.loom",
          "match": "\\b(int|int8|int16|int32|int64|uint8|uint16|uint32|uint64|bigint|float|float32|float64|decimal|bool|char|string|bytes|void)\\b"
        },
        {
          "comment": "Built-in generic collection types (lowercase)",
          "name": "support.type.collection.loom",
          "match": "\\b(list|dict|set|tuple|fn)\\b"
        },
        {
          "comment": "Built-in box / special types (PascalCase)",
          "name": "support.type.class.loom",
          "match": "\\b(AcceleratorBuffer|AcceleratorDevice|AcceleratorFeatures|AcceleratorKind|Actor|AdamOptimizer|AdamWOptimizer|Add|Alignment|Animal|Any|AppError|AsyncIterable|AsyncIterator|AsyncScoped|Atomic|AutodiffError|Axis|Backend|BaseException|BaseExceptionGroup|BigInt|BitAnd|BitNot|BitOr|BitXor|BlockingTimeoutError|Bluetooth|Bool|Box|Bytes|Callable|CancellationToken|Char|Circle|ClassName|Closeable|Codec|Comparable|CompileOptions|ComponentRegistry|ComputeGraph|Config|Connection|Connectivity|Constraints|ConstraintsCatalog|ConstraintsOrigin|Container|Contains|Copyable|Counter|CounterElement|CounterMsg|CudaDevice|CudaHostBuffer|CudaStream|CustomOp|DType|DebugFrame|DebugRuntime|DefaultTestJobFactory|DeviceFeatures|DevicePool|DeviceRegistry|Display|Div|Dog|Duration|Dynamic|EffectHandle|Element|Encoder|Equatable|Err|Error|Event|EventCounter|Exception|ExceptionGroup|ExecutorConfig|FeatureAttachedObject|FeatureConstraints|FeatureFilter|FeatureMask|FeatureTag|Finalizable|Float|FloorDiv|From|GeneratorExit|GpuBuffer|GpuCompileError|GpuDispatchError|GpuKernel|GpuKernelBinding|GpuProfiler|GradScaler|HDR|HasArea|Hashable|HttpClient|IMutableMap|IReadableMap|ImageFit|Index|IndexSet|InjectionMoment|InjectionRegistry|InjectionScope|Instant|Int|IntegratedTestJobFactory|Iterable|Iterator|KeyLookup|KeyboardInterrupt|LifetimeErrorKind|LocalState|Match|MathUtils|Menu|MenuBar|MenuItem|Mod|Module|ModuleLoadError|MountHandle|Mul|Mutex|MutexGuard|Name|NativeHandle|Neg|Node|None|NotFoundError|Ok|Optimizer|Option|Point|PortalActivation|Pow|RMSpropOptimizer|Range|RangeIterator|Readable|Regex|RenderContext|Renderable|Request|ResourceLifespan|Response|Result|Runtime|RwLock|RwLockReadGuard|RwLockWriteGuard|SafeHtml|Scoped|ScriptWorker|Self|Sendable|SequencerModuleScope|SequencerPhase|SequencerSessionScope|SequencerTestScope|SequencerTestSetupScope|Serializable|SgdOptimizer|Shape|Shl|Shr|Signal|SimpleTestJob|Sized|Sliceable|Some|SortedList|Source|StackFrame|StateSerializer|String|StyleSheet|Sub|SystemExit|T|Task|TaskGroup|TaskLocal|Template|Tensor|TensorBackendError|TensorDTypeError|TensorShapeError|TestActivity|TestCollector|TestGroup|TestJobFactory|TestRef|TestSequencer|Thread|ThreadHandle|ThreadLocal|ThreadPool|ThreadSafeHandle|TimerHandle|Token|TpuBuffer|TpuCompileError|TpuDevice|TpuDispatchError|TpuKernel|TpuPlatform|TpuProgram|TpuProgramFormat|TpuStream|TpuTopology|TpuUnavailableError|TraceEvent|TraceEventKind|TraceHook|TraceLevel|TransactionManager|Tray|Tree|TreeNode|Type|UiRuntime|Url|UrlError|User|Variable|VendorId|View|WebComponentLifecycle|WiFi|Window|WindowConfig|WorkerChannel|WorkerPanicError|WorkerTerminatedError|WorkerTransferError|Writable)\\b"
        },
        {
          "comment": "system.* namespace modules",
          "name": "support.type.namespace.loom",
          "match": "\\b(system|runtime)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.loom",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.loom",
          "match": "\\b(None)\\b"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.loom",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.loom",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.loom",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.loom",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.loom",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },

    "bytes-literal": {
      "patterns": [
        {
          "name": "string.quoted.double.bytes.loom",
          "begin": "\\b(b)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "storage.type.string.bytes.loom" },
            "2": { "name": "punctuation.definition.string.begin.loom" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } },
          "patterns": [
            { "include": "#string-escape" }
          ]
        },
        {
          "name": "string.quoted.single.bytes.loom",
          "begin": "\\b(b)(')",
          "end": "'",
          "beginCaptures": {
            "1": { "name": "storage.type.string.bytes.loom" },
            "2": { "name": "punctuation.definition.string.begin.loom" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } },
          "patterns": [
            { "include": "#string-escape" }
          ]
        }
      ]
    },

    "raw-string": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.loom",
          "begin": "\\b(r)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "storage.type.string.raw.loom" },
            "2": { "name": "punctuation.definition.string.begin.loom" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } }
        },
        {
          "name": "string.quoted.single.raw.loom",
          "begin": "\\b(r)(')",
          "end": "'",
          "beginCaptures": {
            "1": { "name": "storage.type.string.raw.loom" },
            "2": { "name": "punctuation.definition.string.begin.loom" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } }
        }
      ]
    },

    "interpolated-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.loom",
          "begin": "\\b(i)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "storage.type.string.interpolated.loom" },
            "2": { "name": "punctuation.definition.string.begin.loom" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } },
          "patterns": [
            { "include": "#string-interpolation" },
            { "include": "#string-escape" }
          ]
        },
        {
          "name": "string.quoted.single.interpolated.loom",
          "begin": "\\b(i)(')",
          "end": "'",
          "beginCaptures": {
            "1": { "name": "storage.type.string.interpolated.loom" },
            "2": { "name": "punctuation.definition.string.begin.loom" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } },
          "patterns": [
            { "include": "#string-interpolation" },
            { "include": "#string-escape" }
          ]
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.loom",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.loom" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } },
          "patterns": [
            { "include": "#string-escape" }
          ]
        },
        {
          "name": "string.quoted.single.loom",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.loom" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } },
          "patterns": [
            { "include": "#string-escape" }
          ]
        }
      ]
    },

    "string-escape": {
      "name": "constant.character.escape.loom",
      "match": "\\\\([\\\\'\"nrt0]|u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|\\{\\$|\\{%)"
    },

    "string-interpolation": {
      "name": "meta.interpolation.loom",
      "begin": "\\{\\$-?",
      "end": "-?\\$\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.loom" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.loom" } },
      "patterns": [
        { "include": "source.loom" }
      ]
    },

    "multiline-string-double": {
      "name": "string.quoted.triple.double.loom",
      "begin": "\"\"\"(\\([^)]*\\))?",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.loom" },
        "1": { "name": "meta.string.descriptor.loom" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } },
      "patterns": [
        { "include": "#string-interpolation" },
        { "include": "#string-escape" }
      ]
    },

    "multiline-string-single": {
      "name": "string.quoted.triple.single.loom",
      "begin": "'''(\\([^)]*\\))?",
      "end": "'''",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.loom" },
        "1": { "name": "meta.string.descriptor.loom" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.loom" } },
      "patterns": [
        { "include": "#string-interpolation" },
        { "include": "#string-escape" }
      ]
    },

    "template-fence": {
      "patterns": [
        { "include": "#template-fence-html" },
        { "include": "#template-fence-ui" },
        { "include": "#template-fence-javascript" },
        { "include": "#template-fence-typescript" },
        { "include": "#template-fence-python" },
        { "include": "#template-fence-sql" },
        { "include": "#template-fence-css" },
        { "include": "#template-fence-json" },
        { "include": "#template-fence-markdown" },
        { "include": "#template-fence-shell" },
        { "include": "#template-fence-generic" }
      ]
    },

    "template-fence-html": {
      "name": "meta.template.fence.html.loom",
      "begin": "(`{3,})(\\()(html)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.html",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "text.html.basic" }
      ]
    },

    "template-fence-ui": {
      "comment": "Cross-platform UI fence (v0.6+) — uses Loom component primitives",
      "name": "meta.template.fence.ui.loom",
      "begin": "(`{3,})(\\()(ui)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.ui",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "#ui-component-tag" },
        { "include": "text.html.basic" }
      ]
    },

    "ui-component-tag": {
      "comment": "PascalCase component tags in ui fences: <Row>, <Column>, <Text>, etc.",
      "name": "meta.tag.component.ui.loom",
      "match": "</?([A-Z][a-zA-Z0-9]*)\\b",
      "captures": {
        "1": { "name": "entity.name.tag.component.loom" }
      }
    },

    "template-fence-javascript": {
      "name": "meta.template.fence.javascript.loom",
      "begin": "(`{3,})(\\()(js)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "source.js" }
      ]
    },

    "template-fence-typescript": {
      "name": "meta.template.fence.typescript.loom",
      "begin": "(`{3,})(\\()(ts)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.typescript",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "source.ts" }
      ]
    },

    "template-fence-python": {
      "name": "meta.template.fence.python.loom",
      "begin": "(`{3,})(\\()(py)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.python",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "source.python" }
      ]
    },

    "template-fence-sql": {
      "name": "meta.template.fence.sql.loom",
      "begin": "(`{3,})(\\()(sql)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.sql",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "source.sql" }
      ]
    },

    "template-fence-css": {
      "name": "meta.template.fence.css.loom",
      "begin": "(`{3,})(\\()(css)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "source.css" }
      ]
    },

    "template-fence-json": {
      "name": "meta.template.fence.json.loom",
      "begin": "(`{3,})(\\()(json)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.json",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "source.json" }
      ]
    },

    "template-fence-markdown": {
      "name": "meta.template.fence.markdown.loom",
      "begin": "(`{3,})(\\()(md)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.markdown",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "text.html.markdown" }
      ]
    },

    "template-fence-shell": {
      "name": "meta.template.fence.shell.loom",
      "begin": "(`{3,})(\\()(sh)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "meta.embedded.block.shell",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" },
        { "include": "source.shell" }
      ]
    },

    "template-fence-generic": {
      "comment": "Catch-all template fence for any language not specifically matched above",
      "name": "meta.template.fence.loom",
      "begin": "(`{3,})(\\()([a-zA-Z][a-zA-Z0-9_]*)(\\))(:\\([^)]*\\))?",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.loom" },
        "2": { "name": "punctuation.definition.descriptor.begin.loom" },
        "3": { "name": "entity.name.tag.template.language.loom" },
        "4": { "name": "punctuation.definition.descriptor.end.loom" },
        "5": { "name": "meta.template.descriptor.loom" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.loom" }
      },
      "contentName": "string.unquoted.template.loom",
      "patterns": [
        { "include": "#template-directives" },
        { "include": "#template-expressions" }
      ]
    },

    "template-directives": {
      "name": "meta.template.directive.loom",
      "begin": "\\{%-?",
      "end": "-?%\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.directive.begin.loom" } },
      "endCaptures": { "0": { "name": "punctuation.section.directive.end.loom" } },
      "patterns": [
        {
          "name": "keyword.control.template.loom",
          "match": "\\b(if|elif|else|for|while|do|end|try|catch|finally|match|break|continue|let|var|outer|await|suspend)\\b"
        },
        { "include": "source.loom" }
      ]
    },

    "template-expressions": {
      "name": "meta.template.expression.loom",
      "begin": "\\{\\$-?",
      "end": "-?\\$\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.loom" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.loom" } },
      "patterns": [
        {
          "comment": "v0.7 | raw filter for explicit unescaped output",
          "name": "keyword.operator.filter.raw.loom",
          "match": "\\|\\s*raw\\b"
        },
        {
          "comment": "v0.7 other pipe filters",
          "name": "keyword.operator.filter.loom",
          "match": "\\|\\s*[a-zA-Z_][a-zA-Z0-9_]*"
        },
        { "include": "source.loom" }
      ]
    },

    "extern-declarations": {
      "patterns": [
        {
          "comment": "extern js fun / extern js val",
          "name": "meta.extern.js.loom",
          "match": "\\b(extern)\\s+(js)\\s+(func|fun|val)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.extern.loom" },
            "2": { "name": "storage.modifier.js.loom" },
            "3": { "name": "storage.type.function.loom" },
            "4": { "name": "entity.name.function.loom" }
          }
        },
        {
          "comment": "extern native \"lib\" fun",
          "name": "meta.extern.native.loom",
          "match": "\\b(extern)\\s+(native)\\s+(\"[^\"]+\")\\s+(func|fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.extern.loom" },
            "2": { "name": "storage.modifier.native.loom" },
            "3": { "name": "string.quoted.double.loom" },
            "4": { "name": "storage.type.function.loom" },
            "5": { "name": "entity.name.function.loom" }
          }
        },
        {
          "comment": "extern native \"lib\" val",
          "name": "meta.extern.native.val.loom",
          "match": "\\b(extern)\\s+(native)\\s+(\"[^\"]+\")\\s+(val)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.extern.loom" },
            "2": { "name": "storage.modifier.native.loom" },
            "3": { "name": "string.quoted.double.loom" },
            "4": { "name": "storage.type.loom" },
            "5": { "name": "entity.name.function.loom" }
          }
        }
      ]
    },

    "macro-declaration": {
      "comment": "macro name(params) { ... }",
      "name": "meta.macro.loom",
      "match": "\\b(macro)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.macro.loom" },
        "2": { "name": "entity.name.function.macro.loom" }
      }
    },

    "macro-invocation": {
      "comment": "name!(...) — macro invocation distinguished by trailing !",
      "name": "meta.macro.invocation.loom",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(!)(\\()",
      "captures": {
        "1": { "name": "entity.name.function.macro.loom" },
        "2": { "name": "keyword.operator.macro.loom" },
        "3": { "name": "punctuation.section.parens.begin.loom" }
      }
    },

    "async-gen-function-declaration": {
      "comment": "async gen fun name",
      "name": "meta.function.async-gen.loom",
      "match": "\\b(async)\\s+(gen)\\s+(func|fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.async.loom" },
        "2": { "name": "storage.modifier.gen.loom" },
        "3": { "name": "storage.type.function.loom" },
        "4": { "name": "entity.name.function.loom" }
      }
    },

    "gen-function-declaration": {
      "comment": "gen fun name",
      "name": "meta.function.gen.loom",
      "match": "\\b(gen)\\s+(func|fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.gen.loom" },
        "2": { "name": "storage.type.function.loom" },
        "3": { "name": "entity.name.function.loom" }
      }
    },

    "function-declaration": {
      "name": "meta.function.loom",
      "match": "\\b(func|fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.loom" },
        "2": { "name": "entity.name.function.loom" }
      }
    },

    "async-function-declaration": {
      "name": "meta.function.async.loom",
      "match": "\\b(async)\\s+(func|fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.async.loom" },
        "2": { "name": "storage.type.function.loom" },
        "3": { "name": "entity.name.function.loom" }
      }
    },

    "operator-method-declaration": {
      "comment": "operator fun +/- etc.",
      "name": "meta.function.operator.loom",
      "match": "\\b(operator)\\s+(func|fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*|\\+|-|\\*|/|%|\\*\\*|&|\\||\\^|~|<<|>>|\\[\\]|\\[\\]=|==|contains|\\(\\)|\\+=|-=|\\*=|/=|%=|\\*\\*=|<<=|>>=|&=|\\|=|\\^=)",
      "captures": {
        "1": { "name": "storage.modifier.operator.loom" },
        "2": { "name": "storage.type.function.loom" },
        "3": { "name": "entity.name.function.operator.loom" }
      }
    },

    "enum-declaration": {
      "name": "meta.enum.loom",
      "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.enum.loom" },
        "2": { "name": "entity.name.type.enum.loom" }
      }
    },

    "struct-declaration": {
      "comment": "struct Name { ... }",
      "name": "meta.struct.loom",
      "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.struct.loom" },
        "2": { "name": "entity.name.type.struct.loom" }
      }
    },

    "abstract-class-declaration": {
      "name": "meta.class.abstract.loom",
      "match": "\\b(abstract)\\s+(class)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.abstract.loom" },
        "2": { "name": "storage.type.class.loom" },
        "3": { "name": "entity.name.type.class.loom" }
      }
    },

    "class-declaration": {
      "patterns": [
        {
          "name": "meta.class.dynamic.loom",
          "match": "\\b(dynamic)\\s+(class)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.dynamic.loom" },
            "2": { "name": "storage.type.class.loom" },
            "3": { "name": "entity.name.type.class.loom" }
          }
        },
        {
          "name": "meta.class.loom",
          "match": "\\b(class)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.loom" },
            "2": { "name": "entity.name.type.class.loom" }
          }
        }
      ]
    },

    "interface-declaration": {
      "name": "meta.interface.loom",
      "match": "\\b(interface)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.interface.loom" },
        "2": { "name": "entity.name.type.interface.loom" }
      }
    },

    "type-alias-declaration": {
      "comment": "type Name = Type;",
      "name": "meta.type-alias.loom",
      "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.alias.loom" },
        "2": { "name": "entity.name.type.alias.loom" }
      }
    },

    "portal-statement": {
      "name": "meta.portal.loom",
      "match": "\\b(portal)\\s+([a-zA-Z_][a-zA-Z0-9_.]*|\"[^\"]*\")",
      "captures": {
        "1": { "name": "keyword.control.portal.loom" },
        "2": { "name": "entity.name.tag.portal.loom" }
      }
    },

    "import-statement": {
      "patterns": [
        {
          "comment": "from ... import ...",
          "name": "meta.import.loom",
          "match": "\\b(from)\\s+([a-zA-Z_][a-zA-Z0-9_.]*|\\.[a-zA-Z0-9_.]*|\\.\\|[a-zA-Z0-9_.]*|\\.\\.\\.?[a-zA-Z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.loom" },
            "2": { "name": "entity.name.namespace.loom" }
          }
        }
      ]
    },

    "reexport-statement": {
      "comment": "pub from ... import (...) — re-export syntax (v0.6)",
      "name": "meta.reexport.loom",
      "match": "\\b(pub)\\s+(from)\\s+([a-zA-Z_][a-zA-Z0-9_.]*|\\.[a-zA-Z0-9_.]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.loom" },
        "2": { "name": "keyword.control.import.loom" },
        "3": { "name": "entity.name.namespace.loom" }
      }
    },

    "dynamic-field-access": {
      "name": "meta.dynamic-field.loom",
      "begin": "!\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.dynamic-field.begin.loom" } },
      "endCaptures": { "0": { "name": "punctuation.section.dynamic-field.end.loom" } },
      "patterns": [
        {
          "name": "variable.other.dynamic-field.loom",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "include": "#strings"
        }
      ]
    },

    "variable-declaration": {
      "comment": "let/var name = ... — scopes the name as a declared variable",
      "match": "\\b(let|var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.loom" },
        "2": { "name": "variable.other.readwrite.loom" }
      }
    },

    "type-annotation": {
      "comment": "Colon followed by a type name — : Type or : list[Type]",
      "match": "(:\\s*)([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.operator.type.annotation.loom" },
        "2": { "name": "entity.name.type.loom" }
      }
    },

    "method-call": {
      "comment": "obj.method() — scopes the method name",
      "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "support.function.method.loom" }
      }
    },

    "function-call": {
      "comment": "name() — scopes function calls distinctly from declarations",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "support.function.loom" }
      }
    },

    "operators": {
      "patterns": [
        {
          "comment": "Optional chaining and null coalescing",
          "name": "keyword.operator.optional.loom",
          "match": "\\?\\.|\\.\\?|\\?\\?"
        },
        {
          "comment": "Arrow for match arms and lambdas",
          "name": "keyword.operator.arrow.loom",
          "match": "=>"
        },
        {
          "comment": "Exponentiation assignment",
          "name": "keyword.operator.assignment.compound.loom",
          "match": "\\*\\*="
        },
        {
          "comment": "Shift assignment",
          "name": "keyword.operator.assignment.compound.loom",
          "match": "(<<=|>>=)"
        },
        {
          "comment": "Compound assignment operators",
          "name": "keyword.operator.assignment.compound.loom",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=)"
        },
        {
          "comment": "Exponentiation",
          "name": "keyword.operator.arithmetic.exponent.loom",
          "match": "\\*\\*"
        },
        {
          "comment": "Shift operators",
          "name": "keyword.operator.bitwise.shift.loom",
          "match": "(<<|>>)"
        },
        {
          "comment": "Comparison and equality",
          "name": "keyword.operator.comparison.loom",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "comment": "Logical",
          "name": "keyword.operator.logical.loom",
          "match": "&&|\\|\\||!"
        },
        {
          "comment": "Bitwise NOT",
          "name": "keyword.operator.bitwise.not.loom",
          "match": "~"
        },
        {
          "comment": "Bitwise AND",
          "name": "keyword.operator.bitwise.and.loom",
          "match": "&"
        },
        {
          "comment": "Bitwise XOR",
          "name": "keyword.operator.bitwise.xor.loom",
          "match": "\\^"
        },
        {
          "comment": "Arithmetic",
          "name": "keyword.operator.arithmetic.loom",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "comment": "Assignment",
          "name": "keyword.operator.assignment.loom",
          "match": "="
        },
        {
          "comment": "Colon for type annotations and ternary",
          "name": "keyword.operator.type.annotation.loom",
          "match": ":"
        },
        {
          "comment": "Pipe (template filter / bitwise OR)",
          "name": "keyword.operator.pipe.loom",
          "match": "\\|"
        },
        {
          "comment": "Result propagation postfix ?",
          "name": "keyword.operator.propagation.loom",
          "match": "\\?"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.loom", "match": "," },
        { "name": "punctuation.terminator.statement.loom", "match": ";" },
        { "name": "punctuation.section.block.begin.loom", "match": "\\{" },
        { "name": "punctuation.section.block.end.loom", "match": "\\}" },
        { "name": "punctuation.section.parens.begin.loom", "match": "\\(" },
        { "name": "punctuation.section.parens.end.loom", "match": "\\)" },
        { "name": "punctuation.section.brackets.begin.loom", "match": "\\[" },
        { "name": "punctuation.section.brackets.end.loom", "match": "\\]" },
        { "name": "punctuation.accessor.dot.loom", "match": "\\." }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "comment": "Dunder identifiers for module introspection",
          "name": "variable.language.dunder.loom",
          "match": "\\b(__name__|__file__|__execmode__|__module__)\\b"
        },
        {
          "comment": "this keyword for class instance reference",
          "name": "variable.language.this.loom",
          "match": "\\bthis\\b"
        },
        {
          "comment": "UPPER_CASE constants",
          "name": "variable.other.constant.loom",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "comment": "PascalCase type reference",
          "name": "entity.name.type.loom",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "comment": "property access: .name",
          "name": "variable.other.property.loom",
          "match": "(?<=\\.)[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "comment": "Regular variables",
          "name": "variable.other.loom",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
