{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loup Package Manifest",
  "scopeName": "source.loup-pkg",
  "fileTypes": ["lppkg"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#top-level-keys" },
    { "include": "#inline-table" },
    { "include": "#dependency-entry" },
    { "include": "#target-directive" },
    { "include": "#native-directive" },
    { "include": "#build-directive" },
    { "include": "#strings" },
    { "include": "#version-constraint" },
    { "include": "#boolean-value" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.loup-pkg",
      "match": "#.*$"
    },
    "sections": {
      "comment": "Section headers including [deps], [dev-deps], [dev-overrides], [build], [target.X], [registry]",
      "match": "^\\s*(\\[[a-zA-Z0-9_.\\-]+\\])\\s*$",
      "captures": {
        "1": { "name": "entity.name.section.loup-pkg" }
      }
    },
    "top-level-keys": {
      "match": "^\\s*(package|version|loup|stable_abi|abi_version|shared_abi_version)\\s+(.+)$",
      "captures": {
        "1": { "name": "keyword.other.definition.loup-pkg" },
        "2": { "name": "string.unquoted.value.loup-pkg" }
      }
    },
    "build-directive": {
      "comment": "Build-table keys (§2.5.2, §24.21, v1.18 §13.5b): mode, shared_abi_version, portal_ring_size, stack_size, debug channels",
      "match": "^\\s*(mode|shared_abi_version|portal_ring_size|stack_size|timeTravelEnabled|debug_control_channel|debug_trace_channel)\\s*(=)\\s*(.+)$",
      "captures": {
        "1": { "name": "keyword.control.build.loup-pkg" },
        "2": { "name": "keyword.operator.assignment.loup-pkg" },
        "3": { "name": "string.unquoted.value.loup-pkg" }
      }
    },
    "inline-table": {
      "comment": "TOML inline table values such as { path = \"...\", version = \"^1.0\" }",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.inline-table.begin.loup-pkg" } },
      "endCaptures": { "0": { "name": "punctuation.section.inline-table.end.loup-pkg" } },
      "patterns": [
        {
          "match": "\\b(path|version|git|branch|tag|rev|registry|features|optional)\\b\\s*(=)",
          "captures": {
            "1": { "name": "keyword.other.key.loup-pkg" },
            "2": { "name": "keyword.operator.assignment.loup-pkg" }
          }
        },
        { "include": "#strings" },
        { "include": "#boolean-value" },
        { "include": "#version-constraint" },
        { "name": "punctuation.separator.comma.loup-pkg", "match": "," }
      ]
    },
    "dependency-entry": {
      "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_.\\-]*)\\s*=\\s*(\"[^\"]*\"|'[^']*'|\\[.*\\])",
      "captures": {
        "1": { "name": "entity.name.tag.dependency.loup-pkg" },
        "2": { "name": "string.quoted.version.loup-pkg" }
      }
    },
    "target-directive": {
      "match": "^\\s*(include|exclude|state_integrity|csp)\\s+(.+)",
      "captures": {
        "1": { "name": "keyword.control.target.loup-pkg" },
        "2": { "name": "entity.name.namespace.loup-pkg" }
      }
    },
    "native-directive": {
      "comment": "Native build directives: link, link_path, framework",
      "match": "^\\s*(link|link_path|framework)\\s+(.+)$",
      "captures": {
        "1": { "name": "keyword.control.native.loup-pkg" },
        "2": { "name": "string.unquoted.value.loup-pkg" }
      }
    },
    "boolean-value": {
      "name": "constant.language.boolean.loup-pkg",
      "match": "\\b(true|false)\\b"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.loup-pkg",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.loup-pkg",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "version-constraint": {
      "name": "constant.numeric.version.loup-pkg",
      "match": "\\b[0-9]+(\\.[0-9]+){0,2}\\b"
    },
    "identifiers": {
      "name": "variable.other.loup-pkg",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_.\\-]*\\b"
    }
  }
}
