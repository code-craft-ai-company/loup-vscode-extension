    "template-directives": {
      "patterns": [
        {
          "name": "meta.template.comment.loup",
          "begin": "\\{%--",
          "end": "--%\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.template.begin.loup"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.template.end.loup"
            }
          },
          "contentName": "comment.block.template.loup"
        },
        {
          "name": "meta.template.directive.loup",
          "begin": "(\\{%-?)",
          "end": "(-?%\\})",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.embedded.directive.begin.loup"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.embedded.directive.end.loup"
            }
          },
          "patterns": [
            {
              "name": "keyword.control.template.loup",
              "match": "\\b(if|else\\s+if|else|for|in|while|with|match|case|switch|default|break|continue|let|var|raw|end)\\b"
            },
            {
              "include": "source.loup"
            }
          ]
        }
