{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loup",
  "scopeName": "source.loup",
  "fileTypes": [
    "loup",
    "lpscr",
    "lpfree",
    "lpweb",
    "lphc"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#mode-directive"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#template-fences"
    },
    {
      "include": "#multiline-strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#portal"
    },
    {
      "include": "#extern"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#memory-strategy"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#lifetime-labels"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#dynamic-field-access"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#punctuation"
