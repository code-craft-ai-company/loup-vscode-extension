  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.loup",
          "match": "(##).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.loup"
            }
          }
        },
        {
          "name": "comment.line.number-sign.loup",
          "match": "(#).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.loup"
            }
          }
        },
        {
          "name": "comment.block.loup",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.loup"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.loup"
            }
          }
        }
      ]
    },
    "mode-directive": {
      "patterns": [
        {
          "name": "meta.directive.mode.loup",
          "match": "(@)(mode)(\\()\\s*(web\\.scripted|web\\.compiled|host\\.scripted|host\\.dual|host\\.native|freestanding|portable)\\s*(\\))",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.loup"
            },
            "2": {
              "name": "storage.modifier.annotation.mode.loup"
            },
            "3": {
              "name": "punctuation.section.parens.begin.loup"
            },
            "4": {
              "name": "constant.language.mode.loup"
            },
            "5": {
              "name": "punctuation.section.parens.end.loup"
            }
          }
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.loup",
          "match": "(@)(jsexport|unsafe|compiled|inline|repr|interrupt|interruptSafe|naked|callconv|entry|panic_handler|allocator|deallocator|debug_control_channel|debug_trace_channel|webcomponent|vectorize|signalSafe|polymorphic|tagged|serialField|alias|skip|sensitive|serializationId|migrateFrom|total|complete|must_resolve|noderef|strategy|assume|scheduler|domain|interchange|field)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.loup"
            },
            "2": {
              "name": "storage.modifier.annotation.loup"
            }
          }
        },
        {
          "name": "meta.annotation.custom.loup",
          "match": "(@)([\\p{L}_][\\p{L}\\p{N}_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.loup"
            },
            "2": {
              "name": "entity.name.function.decorator.loup"
            }
          }
        }
      ]
    },
    "lifetime-labels": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.static.loup",
          "match": "~static\\b"
        },
        {
          "name": "entity.name.type.lifetime.loup",
          "match": "~[\\p{Ll}\\p{Lo}_][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },
    "template-fences": {
      "patterns": [
        {
          "name": "meta.template-fence.html.loup",
          "begin": "(`{3,})\\s*\\(\\s*(html)\\s*(?:,\\s*([^)]*))?\\)\\s*(?::\\s*\\(([^)]*)\\))?",
          "end": "^\\s*(\\1)(?!`)\\s*(;)?",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.template-fence.begin.loup"
            },
            "2": {
              "name": "entity.name.tag.template-language.loup"
            },
            "3": {
              "name": "variable.parameter.template-descriptor.loup"
            },
            "4": {
              "name": "variable.parameter.template-format.loup"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.template-fence.end.loup"
            },
            "2": {
              "name": "punctuation.terminator.statement.loup"
            }
          },
          "contentName": "meta.embedded.block.html",
          "patterns": [
            {
              "include": "#template-directives"
            },
            {
              "include": "#template-interpolation"
            },
            {
              "include": "text.html.basic"
