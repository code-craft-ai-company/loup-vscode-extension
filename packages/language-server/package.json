{
  "name": "loup-language-server",
  "version": "1.21.1",
  "description": "Language Server Protocol implementation for the Loup programming language",
  "private": true,
  "main": "./out/server.js",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --outfile=out/server.js --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
