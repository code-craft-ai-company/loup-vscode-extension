# loom.pkg — sample manifest for grammar verification

package   my-app
version   1.4.0
loom      ">=0.4"

[deps]
system.http  = "^2.0"
jsonschema   = "^1.4"
ui-toolkit   = "^0.8"

[dev-deps]
test-runner  = "^3.1"

[target.browser]
exclude system.fs
exclude system.proc

[target.cli]
include system.fs
include system.proc

[target.service]
include system.fs
include system.proc
include system.net
