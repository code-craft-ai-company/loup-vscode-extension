# loup.pkg — sample manifest for grammar verification (Loup v1.18 §13.3, §13.5b)

package              my-app
version              1.4.0
loup                 ">=1.18"
shared_abi_version   1

[deps]
net.http     = "^2.0"
jsonschema   = "^1.4"
ui-toolkit   = "^0.8"

[dev-deps]
test-runner  = "^3.1"

[dev-overrides]
# my-utils = { path = "../my-utils" }

[target.browser]
exclude io.fs
exclude io.proc

[target.cli]
include io.fs
include io.proc

[target.service]
include io.fs
include io.proc
include net.net

[target.desktop]
include io.fs
include io.proc
include net.net
include ui.desktop

[target.native]
include io.fs
include io.proc
include net.net
