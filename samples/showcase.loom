// --- Enums -------------------------------------------------------------------
enum Shape {
  Circle(radius: float),
  Rect(w: float, h: float),
  Point,
}

enum Tree[T] {
  Leaf(value: T),
  Node(left: Tree[T], right: Tree[T]),
}

// --- Interfaces --------------------------------------------------------------
interface Drawable {
  fun draw(): void;
  fun boundingBox(): Rect;
}

interface From[E] {
  static fun from(err: E): Self;
}

// --- Classes -----------------------------------------------------------------
class Canvas : Any {
  pub width: int;
  pub height: int;

  pub fun clear(): void {
    // ...
  }
}

dynamic class Config {
  pub name: string;
}

// --- Functions ---------------------------------------------------------------
fun area(shape: Shape): float {
  return match shape {
    Circle(r)    => 3.14159 * r * r,
    Rect(w, h)   => w * h,
    Point        => 0.0,
  };
}

fun describe(x: Any): string {
  return match x {
    Circle(r)  => "circle with radius {$ r $}",
    Rect(w, h) => "rect {$ w $}x{$ h $}",
    Point      => "a point",
    _          => "something else",
  };
}

// --- Option / Result ---------------------------------------------------------
fun safeDivide(a: float, b: float): Result[float, string] {
  if (b == 0.0) {
    return Err("division by zero");
  }
  return Ok(a / b);
}

fun process(path: string): Result[string, AppError] {
  let raw    = readText(path)?;
  let parsed = parse(raw)?;
  return Ok(transform(parsed));
}

let name: string = user?.profile?.displayName ?? "Anonymous";
let port: int    = config("PORT")?.let(parseInt) ?? 8080;

// --- Async / Await -----------------------------------------------------------
async fun buildPage(): Task[string] {
  let userTask = fetchUser();
  let postsTask = fetchPosts();

  let user = await userTask;
  let posts = await postsTask;
  return renderPage(user, posts);
}

// --- Structured Concurrency --------------------------------------------------
async fun loadDashboard(userId: string): Task[Dashboard] {
  let user: User;
  let config: Config;
  let flags: FeatureFlags;

  await group {
    user   = spawn fetchUser(userId);
    config = spawn fetchConfig();
    flags  = spawn fetchFlags(userId);
  }

  return buildDashboard(user, config, flags);
}

// --- For Await ---------------------------------------------------------------
async fun processLines(path: string): Task[void] {
  for await (line in runtime.fs().linesAsync(path)) {
    process(line);
  }
}

// --- Control Flow ------------------------------------------------------------
if (x > 0) {
  x = x - 1;
}

while (running) {
  tick();
}

for (let i = 0; i < n; i = i + 1) {
  items[i] = compute(i);
}

for (item in collection) {
  process(item);
}

outer: for (let i = 0; i < n; i = i + 1) {
  for (let j = 0; j < m; j = j + 1) {
    if (grid[i][j] == target) {
      break outer;
    }
  }
}

do {
  attempt = try_connect();
} while (!attempt.ok);

// --- Defer -------------------------------------------------------------------
defer close(handle);
defer {
  log("leaving scope");
};

