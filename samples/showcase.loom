await sleep(Duration.ofMillis(500));
let elapsed = Instant.now().durationSince(start);

let squares = map(range(10), fun(x) => x * x);
let evens = filter(squares, fun(x) => x % 2 == 0);
let total = reduce(evens, 0, fun(acc, x) => acc + x);
