let cfg = Config();
cfg!{theme} = "dark";
cfg!{"font-size"} = 14;
let theme: string = cfg!{theme};

dynamic cfg as dobj {
  let x = dobj.foo;
  dobj.bar = 42;
}

# --- Strings & Interpolation -------------------------------------------------
let greeting = i"Hello, {$ name $}";
let outPath = i'out/{$ fileStem $}.txt';
let newlineChar: char = c"\n";

# --- Multiline Strings -------------------------------------------------------
let sql = """(indent=+2, eol="LF")
  SELECT *
  FROM users
  WHERE active = true
""";

let text = '''
  This is a plain
  multiline string
''';

# --- Template Fences ---------------------------------------------------------
let page = ```(html):(format=prettier)
  <div class="container">
    {% if (users.isEmpty()) %}
      <p>No users found.</p>
    {% else %}
      {% for (user in users) %}
        <p>{$ user.name $}</p>
      {% end %}
    {% end %}
  </div>
```;

let query = ```(sql):(none)
  SELECT {$ columns | join(", ") $}
  FROM {$ tableName $}
  WHERE id = {$ id $}
```;

let script = ```(py):(format=black)
  def greet(name):
      print(f"Hello, {name}")

  {% for (fn in functions) %}
  def {$ fn.name $}({$ fn.params | join(", ") $}):
      {$ fn.body $}
  {% end %}
```;

# --- FFI ---------------------------------------------------------------------
extern js func fetch(url: string, opts: Any): Task[Any];
extern js func parseInt(s: string, radix: int): int;
extern js val document: Any;
extern js val window: Any;

extern native "libsqlite3" func sqlite3_open(path: string): NativeHandle;
extern native "libsqlite3" func sqlite3_close(db: NativeHandle): int;

# --- @jsexport ---------------------------------------------------------------
@jsexport
func onMessage(data: string): void {
  process(data);
}

@jsexport
async func fetchSummary(userId: string): Task[string] {
  let user = await fetchUser(userId);
  return buildSummary(user);
}

# --- Reactive UI (ui.web) ----------------------------------------------------
let count   = signal(0);
let doubled = derived(func() => count.get() * 2);

effect(func() {
  log(i"count is now: {$ count.get() $}");
});

func Counter(initialValue: int): View {
  let count = signal(initialValue);
  let label = derived(func() => i"Clicked {$ count.get() $} times");

  return ```(html):(none)
    <div class="counter">
      <p>{$ label.get() $}</p>
      <button onclick="{$ func() { count.set(count.get() + 1); } $}">+</button>
    </div>
  ```;
}

# --- Try / Catch / Finally ---------------------------------------------------
try {
  let data = await fetchData();
  process(data);
} catch (NetworkError as err) {
  log(i"Network error: {$ err.message $}");
} finally {
  cleanup();
}

# --- Annotations -------------------------------------------------------------
@total
@jsexport
func handler(ev: Event): void {
  ev.preventDefault();
}

# --- Standard library usage --------------------------------------------------
let parts = split("a,b,c", ",");
let upper = toUpper("hello");
let cfg2 = parse(readText("config.json"))?;
let host = getString(cfg2, "host")?;

let start = Instant.now();
await sleep(Duration.ofMillis(500));
let elapsed = Instant.now().durationSince(start);

let squares = map(range(10), func(x) => x * x);
let evens = filter(squares, func(x) => x % 2 == 0);
let total = reduce(evens, 0, func(acc, x) => acc + x);
